datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        Int      @id @default(autoincrement())
  public_id String   @unique
  email     String   @unique
  api_key   String   @unique
  records   Record[]
}

model Record {
  id           Int        @id @default(autoincrement())
  public_id    String     @unique
  user_id      Int
  owner        User       @relation(fields: [user_id], references: [id])
  title        String
  category     String
  content      String
  amount_cents Int        @default(0)
  status       String     @default("active")
  created_at   DateTime   @default(now())
  updated_at   DateTime   @updatedAt
  auditLogs    AuditLog[]
}

model AuditLog {
  id               Int      @id @default(autoincrement())
  public_id        String   @unique
  user_id          Int
  user_email       String
  record_public_id String
  record_title     String
  action           String
  metadata_json    String?  // Changed Json? -> String? for SQLite compatibility
  ip_address       String?
  user_agent       String?
  created_at       DateTime @default(now())

  // Opposing relation back to Record
  recordId         Int?
  record           Record?  @relation(fields: [recordId], references: [id])
}